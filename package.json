{
  "name": "hull-down",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "description": "A tank design game. Run a state design bureau, send the prototype to trial, read why it failed. A Longlight Interactive game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/archivo-narrow": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
